{% extends 'base.html.twig' %}
{% block title %}Rapport de mission — Donjons & Dragons{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% block javascripts %}
        {% block importmap %}{{ importmap('appDD') }}{% endblock %}
    {% endblock %}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=MedievalSharp&family=Cinzel:wght@400;700&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<main class="dnd-wrap">
    <article class="parchment" aria-labelledby="mission-title">
        <header class="header">
            <div class="seal" aria-hidden="true">D&w</div>
            <div class="title">
                <h1 id="mission-title">Rapport de mission</h1>
                <p class="subtitle">Chronique des exploits au cœur des catacombes</p>
            </div>
            <div class="seal" aria-hidden="true">Wf12</div>
        </header>

        <div class="hr" ></div>

        <section class="meta" aria-label="Informations générales">
            <div class="card">
                <h3>Compagnie</h3>
                <p>La communauté</p>
            </div>
            <div class="card">
                <h3>Quête</h3>
                <p>Explorer les tréfonds du donjon</p>
            </div>
            <div class="card">
                <h3>Durée</h3>
                {% set start = app.session.get('start') %}
                {% if start %}
                    <p>{{ duration }}</p>
                {% else %}
                    <p>Le cache a été purgé</p>
                {% endif %}
            </div>
        </section>

        <section class="grid" aria-label="Résumé et détails">
            <div class="panel">
                <h2>Résumé de l'aventure</h2>
                <p>Bien joué ! Tu as su triompher des épreuves et sortir libre de ce donjon. Guidé par un esprit affuté, vous avez percé les énigmes des catacombes et vaincu un adversaire aussi ancien que Drucker lui‑même.</p>
                <ul class="badges" aria-label="Faits marquants">
                    <li class="badge">Quêtes résolues : 6</li>
                    <li class="badge">Combats victorieux : 3</li>
                    <li class="badge">Nombre de morts :
                    {% set nbMort = app.session.get('nombre-mort') %}
                        {% if nbMort %}
                            {{ nbMort }}
                        {% else %}
                            cache vidé
                        {% endif %}
                    </li>
                    <li class="badge">Passage secret : 3</li>
                    <li class="badge">Mage</li>
                </ul>
                <div class="hr"></div>
                <h2>Quête principale</h2>
                <div class="timeline" aria-label="Chronologie des événements">
                    <div class="event">
                        <h4>La Clef des secrets</h4>
                        <p>Découvertes de deux clefs permettant de fournir le mot de passe au gnome.</p>
                    </div>
                    <div class="event">
                        {% set troll = app.session.get('stateTroll') %}
                        <h4>Dans un jardin qu'on dirait éternel</h4>
                        {% if troll %}
                            {% if troll == 'A' %}
                                <p>De la magie, des jauges, de la couleur, et un troll de massacré</p>
                            {% elseif troll == 'llort' %}
                                <p>De la magie, des jauges, de la couleur, et un troll de retourné</p>
                            {% else %}
                                <p>De la magie, des jauges, de la couleur, et un troll de déplacé</p>
                            {% endif %}
                        {% else %}
                            <p>De la magie, des jauges, de la couleur, et un troll de moins</p>
                        {% endif %}
                    </div>
                    <div class="event">
                        <h4>La môme</h4>
                        <p>Des lunettes, un crâne, un coffre, des catacombes, ça occupe !</p>
                    </div>
                    <div class="event">
                        <h4>The descent</h4>
                        <p>Trois, quatre, cinq ! </p>
                    </div>
                    <div class="event">
                        <h4>Evolution</h4>
                        <p>Le maitre évolue et fuit</p>
                    </div>
                    <div class="event">
                        <h4>Anatomie d'une chute</h4>
                        <p>Le diable se cache dans les marches d'escalier</p>
                    </div>
                </div>
                <div class="hr"></div>
                <h2>Quêtes secondaires</h2>
                <div class="timeline" aria-label="Chronologie des événements">
                    {% set annexeFilm = app.session.get('annexe-film') %}
                    {% set annexeF12 = app.session.get('annexe-f12') %}
                    {% set tarte = app.session.get('annexe-tarte') %}
                    {% if not annexeFilm or not annexeF12 or not tarte %}
                    <div class="event">
                        <h4>Il y a encore des énigmes!</h4>
                        <p>Je disparais quand je suis complété</p>
                    </div>
                    {% endif %}
                    {% if annexeFilm %}
                        <div class="event">
                            <h4>Vous êtes cinéphiles ?</h4>
                            <p>Pas mal...</p>
                        </div>
                    {% endif %}

                    {% if annexeF12 %}
                        <div class="event">
                            <h4>La touche F12</h4>
                            <p>Il y en a peut-être ailleurs</p>
                        </div>
                    {% endif %}
                    {% if tarte %}
                        <div class="event">
                            <h4>Annule le prompt</h4>
                            <p>Et va faire une tarte vegan</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <aside class="panel" aria-label="Butin et statistiques">
                <h2>Butin récupéré</h2>
                <ul>
                    <li>Clefs — Crève-œil </li>
                    <li>Pipette — qui voit les couleurs</li>
                    <li>Crane — pour nos amis les pies</li>
                    <li>Coffre — perdu, à jamais</li>
                    <li>Parchemin — perdu, à jamais</li>
                </ul>
                <div class="hr"></div>
                <h2>Trophées</h2>
                <div class="stats">
                    <div class="stat"><span>Mètre ruban</span> <b>+2m</b></div>
                    <div class="stat"><span>Trésor</span> <b>+2 or</b></div>
                    <div class="stat"><span>État du groupe</span> <b class="ok">Stable</b></div>
                    <div class="stat"><span>Réputation locale</span> <b>+2</b></div>
                </div>
            </aside>
        </section>

        <footer class="footer">
            <div class="sign">Consigné par: <em>Maitre Developpeur Willy</em></div>
            <div class="wax" aria-label="Sceau royal">Wf12</div>
        </footer>
    </article>
</main>
    <!--Si tu penses avoir trouvé une autre quête secondaire ajoute communaute/score/<nom_de_la_quete>-->
{% endblock %}
