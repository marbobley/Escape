{% extends 'base.html.twig' %}
{% block title %}Les jeux de la communauté!{% endblock %}

{% block body %}
    <div class="container-fluid text-center">
        {{ include('JeuCommunaute/escalier/_passage-sous-escalier.html.twig') }}
        {{ include('JeuCommunaute/escalier/_passage-escalier.html.twig') }}
            <div class="container text-center">
                <div class="row">
                    <div class="col">
                        <img
                                          src="{{ asset('images/l-escalier-a-vis-du-donjon.webp') }}"
                                          alt="Escalier, avec de vieilles pierres represantant le passage vers le niveau suivante"
                                          usemap="#workmap">

                        <map name="workmap">
                            <area shape="rect" coords="133,639,280,830"
                                  alt="Sous l'escalier"
                                  data-bs-toggle="offcanvas"
                                  href="#passageSousEscalier"
                                  role="button"
                                  aria-controls="passageSousEscalier">
                            <area shape="rect" coords="343,430,540,816"
                                  alt="Prendre l'escalier"
                                  data-bs-toggle="offcanvas"
                                  href="#passageEscalier"
                                  role="button"
                                  aria-controls="passageEscalier">
                        </map>
                    </div>
                    <div class="col">
                            {{ include('JeuCommunaute/menu/_menu.html.twig') }}
                            {% set escalier = app.session.get('escalier') %}
                            {% set catacombeOpen = app.session.get('catacombeOpen') %}
                            {% if escalier == 10 and catacombeOpen %}
                                <a href="{{ path('app_escalier_coffre') }}">
                                    <img
                                         src="{{ asset('images/coffre.webp') }}"
                                         alt="Coffre décoré de lumière, et d'un casque romain séparé par un +">
                                </a>
                            {% endif %}
                        <div class="row">
                            {% set escalierFinal = app.session.get('finalEscalier') %}
                            {% if escalierFinal %}
                                <p>VOUS ETES SUR LES TRACES DU METRE</p>
                            {% endif %}
                        </div>

                    </div>
                </div>
            </div>
    </div>

{% endblock %}
