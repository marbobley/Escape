{% extends 'base.html.twig' %}
{% block title %}Les jeux de la communauté!{% endblock %}

{% block body %}
    <div class="container text-center">
        {% if alert == 1 %}
            <div class="alert alert-danger" role="alert">
                Vous en voyez de toutes les couleurs !  !
            </div>
        {% endif %}
        <div class="row">
            <div class="col">
                <p>Il faut savoir se détacher, </p>
                <p>Alors on a compris ? </p>
                {{ form_start(form) }}
                {{ form_end(form) }}
                {{ include('JeuCommunaute/jardin/_revenir-entree-jardin.html.twig') }}
            </div>
            <div class="col">
                {{ include('JeuCommunaute/menu/_menu.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
