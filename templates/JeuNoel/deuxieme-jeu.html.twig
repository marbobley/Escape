
{% extends 'base.html.twig' %}

{% block title %}🎄 Jeu de Noël 🎄{% endblock %}

{% block body %}
    <div class="container-fluid text-center">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <article class="jeu-noel-wrapper">
                        <header class="mb-4">
                            <h1 class="display-4 mb-3">🎄 Jeu de Noël 🎄</h1>
                            <h2 class="h3 text-muted mb-4">Les aventures de Poupette et Leon</h2>
                        </header>

                        {# Section principale #}
                        <div class="card shadow-sm">
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <p>Quand tout à coup Poupi et Léon tombe sur ce petit farceur !</p>
                                    <p></p>
                                    <p></p>
                                </div>
                            </div>
                        </div>

                        {# Section image #}

                    </article>
                </div>
            </div>
        </div>
        <p></p>
        <div>
            <img src="{{ asset('images/noel/lutintrouve.jpg') }}"
                 alt="Poupette et Leon devant le sapin de Noël" usemap="#workmap" >
            <map name="workmap">
                <area shape="rect"
                      coords="438,488,472,554"
                      alt="Elfe trouvé"
                      href="{{ path('app_jardin') }}">
            </map>
        </div>
        {# Section d'aide optionnelle #}
        <div class="mt-4 text-muted">
            <small>
                💡 Astuce : Sortez vos lunettes, les viocs...
            </small>
        </div>
    </div>
{% endblock %}
