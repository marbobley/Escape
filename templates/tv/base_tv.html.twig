<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Jeux TV!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📺</text></svg>">
    {% block stylesheets %}
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Oswald:wght@400;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/tv.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('appTv') }}{% endblock %}
    {% endblock %}
</head>
    <body>
        <header class="tv-header">
            <h1 style="margin: 0;">Plateau TV - Les Grands Jeux</h1>
        </header>

        <main class="tv-container">
            {% block body %}{% endblock %}
        </main>

        <footer class="tv-footer">
            <small>&copy; {{ "now"|date("Y") }} Les jeux de la Télévision • Thème Médias</small>
        </footer>
    </body>
</html>
