{% extends 'tv/base_tv.html.twig' %}

{% block title %}Fin de l'émission{% endblock %}

{% block body %}
    <h2>Merci d'avoir participé !</h2>
    <p>L'émission touche à sa fin. Vous avez brillamment relevé les défis de notre plateau TV.</p>

    <div style="margin-top:2rem; text-align:center; padding:3rem; border:2px dashed var(--tv-gold); border-radius: 15px; background: rgba(255, 215, 0, 0.05);">
        <p style="font-size:2rem; font-family: 'Oswald', sans-serif; color: var(--tv-gold);">Score Final : ILLIMITÉ</p>
        <p>A bientôt pour une nouvelle émission !</p>
    </div>

    <div style="margin-top:3rem; text-align:center;">
        <a href="{{ path('app_tv_home') }}" class="btn-tv">Rejouer</a>
    </div>
{% endblock %}
