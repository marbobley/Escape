{% extends 'tv/base_tv.html.twig' %}

{% block title %}Fin de l'émission{% endblock %}

{% block body %}

    {% if alert == 1 %}
        <div class="alert alert-error"> Et non mauvais mot !.</div>
    {% elseif alert == 2 %}
        <div class="alert alert-success">JOYEUX ANNIVERSAIRE !!!</div>
    {% endif %}
    <h2>Merci d'avoir participé !</h2>
    <p>L'émission touche à sa fin. Vous avez brillamment relevé les défis de notre plateau TV.</p>

    <p>Une question finale.</p>
    <p>Quel est le mot ?</p>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn-tv">Je valide !</button>
    {{ form_end(form) }}

    <div style="margin-top:3rem; text-align:center;">
        <a href="{{ path('app_tv_home') }}" class="btn-tv">Rejouer</a>
    </div>
{% endblock %}
