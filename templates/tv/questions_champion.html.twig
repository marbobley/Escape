{% extends 'tv/base_tv.html.twig' %}

{% block title %}Questions pour un Champion{% endblock %}

{% block body %}
    <h2>Questions pour un Champion</h2>

    {% if alert == 1 %}
        <div class="alert alert-error">Ah non ! Ce n'est pas la bonne réponse. Retentez votre chance pour le Face à Face !</div>
    {% elseif alert == 2 %}
        <div class="alert alert-success">C'est gagné ! Julien Lepers valide votre réponse. Vous remportez la lettre E !</div>
    {% endif %}

    <p>Petit hameau appartenant au Pradet, je suis connu pour mon petit port typiquement méditerranéen !</p>
    <p>L'été, je suis envahi d'estivants pour le plus grand plaisir des locaux ! </p>
    <p>Je suis ... je suis.... </p>



    {{ form_start(form) }}
        <div class="form-row">
            {{ form_widget(form) }}
        </div>
        <button type="submit" class="btn-tv">Je valide !</button>
    {{ form_end(form) }}

    <div style="margin-top:3rem;">
        <a href="{{ path('app_tv_home') }}" class="btn-tv btn-secondary">Retour à l'accueil</a>
    </div>
{% endblock %}
