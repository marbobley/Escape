{% extends 'wedding/base_wedding.html.twig' %}
{% block title %}Les jeux du mariage!{% endblock %}

{% block body %}
    <!-- Section Héro gothique -->
    <section class="hero-goth">
        <div class="veil"></div>
        <div class="content">
            <h1 class="goth-title">Mariage Gothique <span class="goth-accent">&</span> Jeux</h1>
            <p class="lead">Entre ombre et ténèbre, laissez vous tenter par des jeux.</p>
            <div style="margin-top:1.25rem;">
                <a href="#jeux" class="btn-goth">Découvrir les jeux</a>
            </div>
        </div>
    </section>

    <!-- Présentation -->
    <section class="section">
        <div class="container">
            <div class="goth-frame">
                <h2 class="goth-title" style="margin-top:0;">Bienvenue aux festivités</h2>
                <p class="muted">Ces jeux célèbrent l'élégance de l'ombre-obscur. Participez aux jeux inspirés des romances immortelles et laissez la magie opérer.</p>
            </div>
        </div>
    </section>

    <!-- Grille des jeux/activités -->
    <section id="jeux" class="section" aria-labelledby="tit-jeux">
        <div class="container">
            <h2 id="tit-jeux" class="goth-title">Jeux et activités</h2>
            <hr class="divider"/>
            <div class="row" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.25rem;">
                <article class="card-goth text-center">
                    <h3 class="goth-title" style="font-size:1.15rem;">Chasse aux serments</h3>
                    <p class="muted">Retrouvez les 5 fragments de vœux cachés au RDC. Assemblez-les pour un message secret.</p>
                    <a href="{{ path('app_wedding_serments') }}" class="btn-goth">Répondre</a>
                </article>
                <article class="card-goth text-center">
                    <h3 class="goth-title" style="font-size:1.15rem;">Quiz des âmes sœurs</h3>
                    <p class="muted">Testez vos connaissances sur le marié. Le connaissez-vous vraiment ?</p>
                    <a href="{{ path('app_wedding_quizz') }}" class="btn-goth">Démarrer</a>
                </article>
            </div>
        </div>
    </section>

    <!-- Appel à l'action -->
    <section class="section">
        <div class="container" style="text-align:center;">
            <p class="muted">Prêts à jouer sous la bénédiction de la lune <span class="blood">noir</span> ?</p>
        </div>
    </section>

{% endblock %}
