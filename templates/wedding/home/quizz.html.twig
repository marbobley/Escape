{% extends 'wedding/base_wedding.html.twig' %}
{% block title %}Les jeux du mariage!{% endblock %}

{% block body %}
    <!-- Section: Quiz (sans JavaScript, via formulaire Symfony) -->
    <section class="section" aria-labelledby="tit-quiz">
        <div class="container">
            <div class="goth-frame">
                <h1 id="tit-quiz" class="goth-title" style="margin-top:0;">Quiz des âmes sœurs</h1>
                <p class="muted">Réponds aux questions !</p>

                <div style="margin: .5rem 0 0;">
                    <a href="{{ path('app_wedding_home') }}" class="btn-goth" aria-label="← Retour à l'accueil">← Retour à l'accueil</a>
                </div>

                {# Messages d'état selon le paramètre 'alert' fourni par le contrôleur #}
                {% if alert is defined and alert == 2 %}
                    <div role="alert" class="card-goth" style="margin-top:1rem; border-color: rgba(71,177,110,.45); background: #0d1410;">
                        <strong class="goth-title" style="font-size:1rem; color:#9be7b6;">Bonne réponse</strong>
                        <p class="muted" style="margin:.25rem 0 0;">Ton savoir perce les ombres. Continue…12</p>
                    </div>
                {% elseif alert is defined and alert == 1 %}
                    <div role="alert" class="card-goth" style="margin-top:1rem; border-color: rgba(177,0,22,.55); background: #140a0d;">
                        <strong class="goth-title" style="font-size:1rem; color:#ff9aa8;">Mauvaise réponse</strong>
                        <p class="muted" style="margin:.25rem 0 0;">Les ténèbres te jouent des tours. Réessaie.</p>
                    </div>
                {% endif %}

                {# Formulaire Symfony, sans JavaScript #}
                {{ form_start(form, {
                    attr: {
                        class: 'card-goth',
                        style: 'margin-top:1rem;',
                        novalidate: 'novalidate'
                    }
                }) }}
                    <div style="display:flex; gap:.75rem; align-items:flex-end; flex-wrap:wrap;">
                        <div style="flex:1; min-width:260px;">
                            {{ form_label(form.question1, 'Mon deuxième prénom', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.question1, {
                                attr: {
                                    id: 'quiz-q1',
                                    placeholder: 'Entre ta réponse',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.question1) }}
                        </div>
                        <div style="flex:1; min-width:260px;">
                            {{ form_label(form.question2, 'Mon troisième prénom', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.question2, {
                                attr: {
                                    id: 'quiz-q2',
                                    placeholder: 'Entre ta réponse',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.question2) }}
                        </div>
                        <div style="flex:1; min-width:260px;">
                            {{ form_label(form.question3, 'Ma passion', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.question3, {
                                attr: {
                                    id: 'quiz-q3',
                                    placeholder: 'Entre ta réponse',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.question3) }}
                        </div>
                        <div style="flex:1; min-width:260px;">
                            {{ form_label(form.question4, 'Mon nombre de tatouage', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.question4, {
                                attr: {
                                    id: 'quiz-q4',
                                    placeholder: 'Entre ta réponse',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.question4) }}
                        </div>
                        <div style="flex:1; min-width:260px;">
                            {{ form_label(form.question5, 'Mon nombre d\'année d\'étude supérieur', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.question5, {
                                attr: {
                                    id: 'quiz-q4',
                                    placeholder: 'Entre ta réponse',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.question5) }}
                        </div>
                        <div>
                            {{ form_widget(form.save, { attr: { class: 'btn-goth' } }) }}
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>

{% endblock %}
