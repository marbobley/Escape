{% extends 'wedding/base_wedding.html.twig' %}
{% block title %}Les jeux du mariage!{% endblock %}

{% block body %}
    <!-- Section: Serment / Mot de passe -->
    <section class="section" aria-labelledby="tit-serment">
        <div class="container">
            <div class="goth-frame">
                <h1 id="tit-serment" class="goth-title" style="margin-top:0;">Chasse aux serments</h1>
                <p class="muted">Entre le mot secret trouvé parmi les vœux. Un seul mot, un seul destin…</p>

                <div style="margin: .5rem 0 0;">
                    <a href="{{ path('app_wedding_home') }}" class="btn-goth" aria-label="← Retour à l'accueil">← Retour à l'accueil</a>
                </div>

                {# Affichage du message selon le paramètre alert passé par le contrôleur #}
                {% if alert is defined and alert == 2 %}
                    <div role="alert" aria-live="polite" class="card-goth" style="margin-top:1rem; border-color: rgba(71,177,110,.45); background: #0d1410;">
                        <strong class="goth-title" style="font-size:1rem; color:#9be7b6;">Succès</strong>
                        <p class="muted" style="margin:.25rem 0 0;">Le mot d'amour est trouvé F.</p>
                    </div>
                {% elseif alert is defined and alert == 1 %}
                    <div role="alert" class="card-goth" style="margin-top:1rem; border-color: rgba(177,0,22,.55); background: #140a0d;">
                        <strong class="goth-title" style="font-size:1rem; color:#ff9aa8;">Raté</strong>
                        <p class="muted" style="margin:.25rem 0 0;">Le mot d'amour ne correspond pas. Essaie encore.</p>
                    </div>
                {% endif %}

                {# Utilisation du formulaire Symfony sans JavaScript #}
                {{ form_start(form, {
                    attr: {
                        class: 'card-goth',
                        style: 'margin-top:1rem;',
                        novalidate: 'novalidate'
                    }
                }) }}
                    <div style="display:flex; gap:.75rem; align-items:flex-end; flex-wrap:wrap;">
                        <div style="flex:1; min-width:240px;">
                            {{ form_label(form.pass, 'Mot de passe', {
                                label_attr: { class: 'goth-title', style: 'font-size:.95rem; letter-spacing:1px; text-transform:none;' }
                            }) }}
                            {{ form_widget(form.pass, {
                                attr: {
                                    id: 'pass-serment',
                                    placeholder: 'Saisir le mot',
                                    style: 'width:100%; margin-top:.35rem; padding:.6rem .8rem; background:#0f0b0d; color:var(--goth-ivory); border:1px solid rgba(177,152,109,.35);'
                                }
                            }) }}
                            {{ form_errors(form.pass) }}
                        </div>
                        <div>
                            {{ form_widget(form.save, { label: 'Valider', attr: { class: 'btn-goth' } }) }}
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>

{% endblock %}
